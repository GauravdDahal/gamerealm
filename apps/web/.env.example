# Supabase project settings. Find these at:
# https://supabase.com/dashboard/project/YOUR-PROJECT-REF/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ — it bypasses all security
# rules and must never reach the browser. Used later for admin actions that
# cross between users (approving accounts, assigning roles).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Legacy Laravel backend settings below. No longer used once every page is
# switched over to Supabase, but left here until that migration is complete.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

NEXT_PUBLIC_REVERB_APP_ID=local-app-id
NEXT_PUBLIC_REVERB_APP_KEY=local-dev-key
NEXT_PUBLIC_REVERB_APP_SECRET=local-dev-secret
NEXT_PUBLIC_REVERB_HOST="localhost"
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
